# 3-laptop cluster settings. Copy to deploy/cluster.env (git-ignored), fill in the three LAN IPs, then run
#   powershell -ExecutionPolicy Bypass -File deploy\gen_cluster.ps1
# Find each laptop's IP with `ipconfig` (IPv4 Address of the Wi-Fi adapter). All three must be on the same network.
L1_IP=
L2_IP=
L3_IP=

# Ports (defaults match infra/firewall.ps1; change only if something else holds a port)
ORCH_PORT=8000
QUANT_PORT=8101
SENTIMENT_PORT=8102
AGRI_PORT=8103
VECTOR_PORT=8104
INGEST_PORT=8201
MONITOR_PORT=8202
UI_PORT=3000

# Shared secret every service checks (X-Cluster-Key). Leave empty and gen_cluster writes a random one here.
CLUSTER_KEY=

# 0 = real data and real LLMs. 1 = fixtures and canned answers (no Ollama needed).
MOCK=0
# 1 = also show the synthetic DEMO-ODISHA storm, stamped SIMULATED
DEMO_MODE=0
