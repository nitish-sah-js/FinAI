# Copy to .env on every laptop (docs/01_CONTRACTS.md §3). Single-laptop mode: keep all hosts 127.0.0.1.
L1_HOST=127.0.0.1
L2_HOST=127.0.0.1
L3_HOST=127.0.0.1

ORCH_URL=http://${L1_HOST}:8000
QUANT_URL=http://${L2_HOST}:8101
SENTIMENT_URL=http://${L2_HOST}:8102
AGRI_URL=http://${L2_HOST}:8103
VECTOR_URL=http://${L2_HOST}:8104
WEAVIATE_HOST=${L2_HOST}
INGEST_URL=http://${L3_HOST}:8201
MONITOR_URL=http://${L3_HOST}:8202

OLLAMA_L1=http://${L1_HOST}:11434
OLLAMA_L2=http://${L2_HOST}:11434
OLLAMA_L3=http://${L3_HOST}:11434
# Model tags (ollama pull <tag>). Use qwen3:4b-instruct, NOT qwen3:4b (thinking-only build).
OLLAMA_MODEL_L1=qwen3:4b-instruct
OLLAMA_MODEL_L2=gemma3:4b
OLLAMA_MODEL_L3_FAST=qwen3:1.7b
OLLAMA_MODEL_L3_RED=phi4-mini

MOCK=1                 # 1 = fixtures + canned LLM output, nothing else needs to run
DEMO_MODE=0            # 1 = show synthetic demo data (DEMO-ODISHA storm), stamped SIMULATED
CLUSTER_KEY=           # 3-laptop cluster shared secret (X-Cluster-Key header); empty = auth off. Set by deploy/gen_cluster.ps1
CACHE_MODE=record      # record | replay | off
LLM_MODE=local         # local | boost | auto
MOCK_DELAY_MS=300

# Optional free-tier boost (03). Leave empty to stay 100% local.
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
AUTO_MIN_RPD=50
LLM_REPLAY_STRICT=0

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# monitor Tier-3 email (Gmail app password). Put real values only in .env, never commit them.
SMTP_USER=
SMTP_APP_PASSWORD=
ALERT_EMAIL_TO=
FRED_API_KEY=
EIA_API_KEY=
EMBED_DEVICE=cpu

# NASA Earthdata login for services/agri/scripts/refresh_modis.py (free: https://urs.earthdata.nasa.gov)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
