{
  "name": "app",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"npm run next:dev\" \"npm run electron:wait\"",
    "next:dev": "next dev",
    "electron:wait": "wait-on tcp:3000 && electron .",
    "build": "next build",
    "electron:build": "electron-builder",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@xyflow/react": "latest",
    "cmdk": "^1.0.0",
    "framer-motion": "^11.0.8",
    "lightweight-charts": "^4.1.3",
    "lucide-react": "^0.358.0",
    "next": "^14.1.3",
    "react": "^18",
    "react-dom": "^18",
    "react-resizable-panels": "^2.0.13",
    "recharts": "^2.12.3",
    "tailwind-merge": "^2.2.1",
    "zod": "^3.22.4",
    "zustand": "^4.5.2",
    "@tanstack/react-query": "^5.28.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "concurrently": "^8.2.2",
    "electron": "^29.1.1",
    "electron-builder": "^24.13.3",
    "electron-store": "^8.2.0",
    "eslint": "^8",
    "eslint-config-next": "^14.1.3",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "typescript": "^5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.utsava.terminal",
    "productName": "Utsava Terminal",
    "electronVersion": "29.4.6",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "out/**/*",
      "public/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
